# Lets you run `docker compose ...` without -f on every command.
COMPOSE_FILE=docker-compose.dev.yml

# Host port for the dev server.
APP_PORT=3000

# Matches the db service in docker-compose.dev.yml.
DATABASE_URL=postgres://fintrace:fintrace@db:5432/fintrace

# Generate with: openssl rand -base64 33
AUTH_SECRET=

APP_URL=http://localhost:3000

# Your admin login, created by `docker compose exec app pnpm db:seed`.
SEED_USERNAME=
SEED_PASSWORD=

# Optional. Set SMTP_HOST to offer magic-link sign-in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Dev only, to open the dev server from a phone through a tunnel (e.g. `bb connect expose 3000`):
# DEV_ORIGINS=your-share.getbb.app,127.0.0.1
# AUTH_TRUST_HOST=true
