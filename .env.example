# Lets you run `docker compose ...` without -f on every command.
COMPOSE_FILE=docker-compose.dev.yml

# Host port for the dev server.
APP_PORT=3000

# Matches the db service in docker-compose.dev.yml.
DATABASE_URL=postgres://fintrace:fintrace@db:5432/fintrace

# Generate with: openssl rand -base64 33
AUTH_SECRET=

APP_URL=http://localhost:3000

# Your login, created by `docker compose exec app pnpm db:seed`.
SEED_EMAIL=
SEED_PASSWORD=

# Optional. Set SMTP_HOST to offer magic-link sign-in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
